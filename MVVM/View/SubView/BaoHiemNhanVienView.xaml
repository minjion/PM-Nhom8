<UserControl x:Class="QuanLyNhanVien.MVVM.View.SubView.BaoHiemNhanVienView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:QuanLyNhanVien.MVVM.View.SubView"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="CrudButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowButtonTheme}">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="140" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>

        <GroupBox Header="Quản lý bảo hiểm"
                  Margin="0,0,0,8"
                  BorderThickness="0"
                  FontSize="17"
                  FontWeight="SemiBold">
            <Grid Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <Border Margin="10,0,10,8"
                        Padding="12,8"
                        Background="#EFF9F8"
                        CornerRadius="10">
                    <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button x:Name="btnThemBaoHiem"
                                Style="{StaticResource CrudButtonStyle}"
                                Click="btnThemBaoHiem_Click">Thêm bảo hiểm</Button>
                        <Button x:Name="bthXoaBaoHiem"
                                Style="{StaticResource CrudButtonStyle}"
                                Click="bthXoaBaoHiem_Click">Xóa bảo hiểm</Button>
                        <Button x:Name="btn_SuaBaoHiem"
                                Style="{StaticResource CrudButtonStyle}"
                                Click="btn_SuaBaoHiem_Click">Sửa bảo hiểm</Button>
                        <Button x:Name="btn_XemChiTiet"
                                Style="{StaticResource CrudButtonStyle}"
                                Margin="0"
                                Click="btn_XemChiTiet_Click">Xem chi tiết</Button>
                    </WrapPanel>
                </Border>

                <DataGrid x:Name="dtgBaoHiem"
                          Grid.Row="1"
                          Margin="10,6,10,10"
                          FontSize="13"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã bảo hiểm"
                                             Binding="{Binding [Mã bảo hiểm]}"
                                             Width="110" />
                        <DataGridTextColumn Header="Mã nhân viên"
                                             Binding="{Binding [Mã nhân viên]}"
                                             Width="110" />
                        <DataGridTextColumn Header="Ngày cấp sổ"
                                             Binding="{Binding [Ngày cấp sổ]}"
                                             Width="150" />
                        <DataGridTextColumn Header="Nơi cấp sổ"
                                             Binding="{Binding [Nơi cấp sổ]}"
                                             Width="200" />
                        <DataGridTextColumn Header="Ghi chú"
                                             Binding="{Binding [Ghi chú]}"
                                             Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <GroupBox Header="Quản lý thai sản"
                  Grid.Row="1"
                  Margin="0,8,0,0"
                  BorderThickness="0"
                  FontSize="17"
                  FontWeight="SemiBold">
            <Grid Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <Border Margin="10,0,10,8"
                        Padding="12,8"
                        Background="#EFF9F8"
                        CornerRadius="10">
                    <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button x:Name="btnThemThaiSan"
                                Style="{StaticResource CrudButtonStyle}"
                                Click="btnThemThaiSan_Click">Thêm thai sản</Button>
                        <Button x:Name="btnXoaThaiSan"
                                Style="{StaticResource CrudButtonStyle}"
                                Click="btnXoaThaiSan_Click">Xóa thai sản</Button>
                        <Button x:Name="btnSuaThaiSan"
                                Style="{StaticResource CrudButtonStyle}"
                                Click="btnSuaThaiSan_Click">Sửa thai sản</Button>
                        <Button x:Name="btnChiTiet"
                                Style="{StaticResource CrudButtonStyle}"
                                Margin="0"
                                Click="btnChiTiet_Click">Xem chi tiết</Button>
                    </WrapPanel>
                </Border>

                <DataGrid x:Name="dsThaiSanDtg"
                          Grid.Row="1"
                          Margin="10,6,10,10"
                          FontSize="13"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã sổ thai sản"
                                             Binding="{Binding [Mã sổ thai sản]}"
                                             Width="130" />
                        <DataGridTextColumn Header="Mã nhân viên"
                                             Binding="{Binding [Mã nhân viên]}"
                                             Width="110" />
                        <DataGridTextColumn Header="Ngày về sớm"
                                             Binding="{Binding [Ngày về sớm]}"
                                             Width="140" />
                        <DataGridTextColumn Header="Ngày nghỉ sinh"
                                             Binding="{Binding [Ngày nghỉ sinh]}"
                                             Width="140" />
                        <DataGridTextColumn Header="Ngày làm trở lại"
                                             Binding="{Binding [Ngày làm trở lại]}"
                                             Width="160" />
                        <DataGridTextColumn Header="Trợ cấp công ty"
                                             Binding="{Binding [Trợ cấp công ty]}"
                                             Width="150" />
                        <DataGridTextColumn Header="Ghi chú"
                                             Binding="{Binding [Ghi chú]}"
                                             Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

    </Grid>
</UserControl>
