<UserControl x:Class="QuanLyNhanVien.MVVM.View.SubView.BaoHiemNhanVienView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuanLyNhanVien.MVVM.View.SubView"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>

        <GroupBox Header="Quản lý bảo hiểm"
                  Margin="0,0,0,8"
                  BorderThickness="0"
                  FontSize="17"
                  FontWeight="SemiBold">
            <Grid Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="btnThemBaoHiem"
                            Style="{StaticResource WindowButtonTheme}"
                            Width="150"
                            Height="40"
                            Margin="0,0,16,0"
                            FontWeight="Normal"
                            Click="btnThemBaoHiem_Click">Thêm bảo hiểm</Button>
                    <Button x:Name="bthXoaBaoHiem"
                            Grid.Column="1"
                            Style="{StaticResource WindowButtonTheme}"
                            Width="150"
                            Height="40"
                            Margin="16,0"
                            FontWeight="Normal"
                            Click="bthXoaBaoHiem_Click">Xóa bảo hiểm</Button>
                    <Button x:Name="btn_SuaBaoHiem"
                            Grid.Column="2"
                            Style="{StaticResource WindowButtonTheme}"
                            Width="150"
                            Height="40"
                            Margin="16,0"
                            FontWeight="Normal"
                            Click="btn_SuaBaoHiem_Click">Sửa bảo hiểm</Button>
                    <Button x:Name="btn_XemChiTiet"
                            Grid.Column="3"
                            Style="{StaticResource WindowButtonTheme}"
                            Width="150"
                            Height="40"
                            Margin="16,0,0,0"
                            FontWeight="Normal"
                            Click="btn_XemChiTiet_Click">Xem chi tiết</Button>
                </Grid>

                <DataGrid x:Name="dtgBaoHiem"
                          Grid.Row="1"
                          Margin="10,6,10,10"
                          FontSize="13"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã bảo hiểm"
                                             Binding="{Binding [Mã bảo hiểm]}"
                                             Width="110" />
                        <DataGridTextColumn Header="Mã nhân viên"
                                             Binding="{Binding [Mã nhân viên]}"
                                             Width="110" />
                        <DataGridTextColumn Header="Ngày cấp sổ"
                                             Binding="{Binding [Ngày cấp sổ]}"
                                             Width="150" />
                        <DataGridTextColumn Header="Nơi cấp sổ"
                                             Binding="{Binding [Nơi cấp sổ]}"
                                             Width="200" />
                        <DataGridTextColumn Header="Ghi chú"
                                             Binding="{Binding [Ghi chú]}"
                                             Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <GroupBox Header="Quản lý thai sản"
                  Grid.Row="1"
                  Margin="0,8,0,0"
                  BorderThickness="0"
                  FontSize="17"
                  FontWeight="SemiBold">
            <Grid Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="btnThemThaiSan"
                            Style="{StaticResource WindowButtonTheme}"
                            Width="150"
                            Height="40"
                            Margin="0,0,16,0"
                            FontWeight="Normal"
                            Click="btnThemThaiSan_Click">Thêm thai sản</Button>
                    <Button x:Name="btnXoaThaiSan"
                            Grid.Column="1"
                            Style="{StaticResource WindowButtonTheme}"
                            Width="150"
                            Height="40"
                            Margin="16,0"
                            FontWeight="Normal"
                            Click="btnXoaThaiSan_Click">Xóa thai sản</Button>
                    <Button x:Name="btnSuaThaiSan"
                            Grid.Column="2"
                            Style="{StaticResource WindowButtonTheme}"
                            Width="150"
                            Height="40"
                            Margin="16,0"
                            FontWeight="Normal"
                            Click="btnSuaThaiSan_Click">Sửa thai sản</Button>
                    <Button x:Name="btnChiTiet"
                            Grid.Column="3"
                            Style="{StaticResource WindowButtonTheme}"
                            Width="150"
                            Height="40"
                            Margin="16,0,0,0"
                            FontWeight="Normal"
                            Click="btnChiTiet_Click">Xem chi tiết</Button>
                </Grid>

                <DataGrid x:Name="dsThaiSanDtg"
                          Grid.Row="1"
                          Margin="10,6,10,10"
                          FontSize="13"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã sổ thai sản"
                                             Binding="{Binding [Mã sổ thai sản]}"
                                             Width="130" />
                        <DataGridTextColumn Header="Mã nhân viên"
                                             Binding="{Binding [Mã nhân viên]}"
                                             Width="110" />
                        <DataGridTextColumn Header="Ngày về sớm"
                                             Binding="{Binding [Ngày về sớm]}"
                                             Width="140" />
                        <DataGridTextColumn Header="Ngày nghỉ sinh"
                                             Binding="{Binding [Ngày nghỉ sinh]}"
                                             Width="140" />
                        <DataGridTextColumn Header="Ngày làm trở lại"
                                             Binding="{Binding [Ngày làm trở lại]}"
                                             Width="160" />
                        <DataGridTextColumn Header="Trợ cấp công ty"
                                             Binding="{Binding [Trợ cấp công ty]}"
                                             Width="150" />
                        <DataGridTextColumn Header="Ghi chú"
                                             Binding="{Binding [Ghi chú]}"
                                             Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

    </Grid>
</UserControl>
